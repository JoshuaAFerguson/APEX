{
  "name": "@apexcli/core",
  "version": "0.5.0",
  "description": "Core types and utilities for APEX",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./test-utils": {
      "types": "./dist/test-utils/index.d.ts",
      "import": "./dist/test-utils/index.js",
      "require": "./dist/test-utils/index.js",
      "default": "./dist/test-utils/index.js"
    },
    "./test-setup": {
      "types": "./dist/test-setup.d.ts",
      "import": "./dist/test-setup.js",
      "require": "./dist/test-setup.js",
      "default": "./dist/test-setup.js"
    },
    "./test-setup-utils": {
      "types": "./dist/test-setup-utils.d.ts",
      "import": "./dist/test-setup-utils.js",
      "require": "./dist/test-setup-utils.js",
      "default": "./dist/test-setup-utils.js"
    },
    "./test-config": {
      "types": "../../../vitest.shared.config.d.ts",
      "import": "../../../vitest.shared.config.js",
      "require": "../../../vitest.shared.config.js",
      "default": "../../../vitest.shared.config.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js",
      "require": "./dist/tools/index.js",
      "default": "./dist/tools/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js",
      "require": "./dist/mcp/index.js",
      "default": "./dist/mcp/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./test-fixtures": {
      "types": "./dist/test-fixtures/index.d.ts",
      "import": "./dist/test-fixtures/index.js",
      "require": "./dist/test-fixtures/index.js",
      "default": "./dist/test-fixtures/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures/index.d.ts",
      "import": "./dist/fixtures/index.js",
      "require": "./dist/fixtures/index.js",
      "default": "./dist/fixtures/index.js"
    },
    "./test-helpers": {
      "types": "./dist/__tests__/helpers/index.d.ts",
      "import": "./dist/__tests__/helpers/index.js",
      "require": "./dist/__tests__/helpers/index.js",
      "default": "./dist/__tests__/helpers/index.js"
    },
    "./factories": {
      "types": "./dist/factories/index.d.ts",
      "import": "./dist/factories/index.js",
      "require": "./dist/factories/index.js",
      "default": "./dist/factories/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsc || echo ok",
    "postbuild": "node -e \"const fs=require('fs'),p=require('path');fs.mkdirSync(p.join('dist','mcp'),{recursive:true});fs.copyFileSync(p.join('src','mcp','catalog.json'),p.join('dist','mcp','catalog.json'))\"",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run src/__tests__/**/*.test.ts src/test-fixtures/__tests__/**/*.test.ts src/test-utils/__tests__/**/*.test.ts src/fixtures/__tests__/**/*.test.ts src/factories/__tests__/**/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "eventemitter3": "^5.0.1",
    "fast-glob": "^3.3.2",
    "minimatch": "^9.0.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "pixelmatch": "^5.3.0",
    "rotating-file-stream": "^3.2.0",
    "sharp": "^0.33.0",
    "yaml": "^2.3.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/minimatch": "^5.1.2",
    "@types/node": "^20.10.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/sharp": "^0.32.0",
    "fastify": "^4.25.0",
    "typescript": "^5.3.0",
    "undici": "^6.20.0",
    "vitest": "^4.0.15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoshuaAFerguson/apex.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/JoshuaAFerguson/apex/issues"
  },
  "homepage": "https://github.com/JoshuaAFerguson/apex#readme",
  "keywords": [
    "apex",
    "ai",
    "agents",
    "types",
    "utilities"
  ],
  "author": "Joshua A. Ferguson",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}