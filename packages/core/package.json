{
  "name": "@apexcli/core",
  "version": "0.4.0",
  "description": "Core types and utilities for APEX",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./test-utils": {
      "types": "./src/test-utils.d.ts",
      "import": "./src/test-utils.js",
      "require": "./src/test-utils.js",
      "default": "./src/test-utils.js"
    },
    "./test-setup": {
      "types": "./src/test-setup.d.ts",
      "import": "./src/test-setup.js",
      "require": "./src/test-setup.js",
      "default": "./src/test-setup.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js",
      "require": "./dist/tools/index.js",
      "default": "./dist/tools/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js",
      "require": "./dist/mcp/index.js",
      "default": "./dist/mcp/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "src/test-utils.ts",
    "src/test-utils.d.ts",
    "src/test-utils.js",
    "src/test-setup.ts",
    "src/test-setup.d.ts",
    "src/test-setup.js",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && cp src/mcp/catalog.json dist/mcp/catalog.json",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run src/__tests__/**/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "eventemitter3": "^5.0.1",
    "fast-glob": "^3.3.2",
    "minimatch": "^9.0.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "pixelmatch": "^5.3.0",
    "rotating-file-stream": "^3.2.0",
    "sharp": "^0.33.0",
    "yaml": "^2.3.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/minimatch": "^5.1.2",
    "@types/node": "^20.10.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/sharp": "^0.32.0",
    "typescript": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoshuaAFerguson/apex.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/JoshuaAFerguson/apex/issues"
  },
  "homepage": "https://github.com/JoshuaAFerguson/apex#readme",
  "keywords": [
    "apex",
    "ai",
    "agents",
    "types",
    "utilities"
  ],
  "author": "Joshua A. Ferguson",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}