{
  "name": "@apexcli/api",
  "version": "0.7.0",
  "description": "APEX REST API and WebSocket server",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc || echo ok",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit || echo ok",
    "lint": "eslint src/ || echo ok",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@apexcli/browser": "*",
    "@apexcli/core": "*",
    "@apexcli/orchestrator": "*",
    "@fastify/cors": "^9.0.1",
    "@fastify/websocket": "^10.0.1",
    "@slack/bolt": "^4.0.1",
    "@slack/oauth": "^3.0.1",
    "@slack/socket-mode": "^1.3.2",
    "@slack/web-api": "^7.5.1",
    "adaptivecards": "^3.0.4",
    "botbuilder": "^4.23.3",
    "discord.js": "^14.25.1",
    "fastify": "^4.25.0",
    "fastify-plugin": "^4.5.1",
    "pino-pretty": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.15",
    "ws": "^8.16.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoshuaAFerguson/apex.git",
    "directory": "packages/api"
  },
  "bugs": {
    "url": "https://github.com/JoshuaAFerguson/apex/issues"
  },
  "homepage": "https://github.com/JoshuaAFerguson/apex#readme",
  "keywords": [
    "apex",
    "ai",
    "agents",
    "api",
    "rest",
    "websocket"
  ],
  "author": "Joshua A. Ferguson",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
