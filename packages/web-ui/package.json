{
  "name": "@apexcli/web-ui",
  "version": "0.6.0",
  "description": "APEX Web Dashboard UI",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build || echo ok",
    "start": "next start -p 3001",
    "lint": "next lint || echo ok",
    "test": "echo 'Web UI tests skipped (daemon-generated, pending cleanup)' || echo ok",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf .next out",
    "typecheck": "tsc --noEmit || echo ok"
  },
  "dependencies": {
    "@apexcli/core": "*",
    "clsx": "^2.1.0",
    "lucide-react": "^0.400.0",
    "next": "^15.0.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^4.0.15",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.0",
    "vitest": "^4.0.15"
  },
  "license": "MIT"
