{
  "name": "@apexcli/orchestrator",
  "version": "0.5.0",
  "description": "APEX task orchestration engine using Claude Agent SDK",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc || true",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "@anthropic-ai/sdk": "^0.30.0",
    "@apexcli/core": "*",
    "better-sqlite3": "^9.2.2",
    "eventemitter3": "^5.0.1",
    "minimatch": "^10.0.1",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.47.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^24.34.0",
    "turndown": "^7.1.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@apex/test-utils": "*",
    "@types/better-sqlite3": "^7.6.8",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^20.10.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/puppeteer": "^7.0.4",
    "@types/turndown": "^5.0.4",
    "typescript": "^5.3.0",
    "vitest": "^4.0.15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoshuaAFerguson/apex.git",
    "directory": "packages/orchestrator"
  },
  "bugs": {
    "url": "https://github.com/JoshuaAFerguson/apex/issues"
  },
  "homepage": "https://github.com/JoshuaAFerguson/apex#readme",
  "keywords": [
    "apex",
    "ai",
    "agents",
    "orchestration",
    "claude",
    "anthropic"
  ],
  "author": "Joshua A. Ferguson",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
