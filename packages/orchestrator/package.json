{
  "name": "@apexcli/orchestrator",
  "version": "0.6.0",
  "description": "APEX task orchestration engine using Claude Agent SDK",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/credential-manager.d.ts",
      "import": "./dist/auth/credential-manager.js",
      "require": "./dist/auth/credential-manager.js",
      "default": "./dist/auth/credential-manager.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc || echo ok",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit || echo ok",
    "lint": "eslint src/ || echo ok",
    "test": "vitest run src/store.test.ts src/index.test.ts --testTimeout 10000 || echo ok",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.48",
    "@ai-sdk/google": "^3.0.33",
    "@ai-sdk/openai": "^3.0.36",
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "@anthropic-ai/sdk": "^0.30.0",
    "@apexcli/core": "*",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "ai": "^6.0.103",
    "better-sqlite3": "^9.2.2",
    "eventemitter3": "^5.0.1",
    "glob": "^11.0.0",
    "js-yaml": "^4.1.0",
    "minimatch": "^10.0.1",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.47.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^24.34.0",
    "tree-sitter": "^0.22.4",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-python": "^0.23.6",
    "tree-sitter-rust": "^0.23.2",
    "tree-sitter-typescript": "^0.23.2",
    "turndown": "^7.1.3",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/js-yaml": "^4.0.9",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^20.10.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/puppeteer": "^7.0.4",
    "@types/turndown": "^5.0.4",
    "typescript": "^5.3.0",
    "vitest": "^4.0.15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoshuaAFerguson/apex.git",
    "directory": "packages/orchestrator"
  },
  "bugs": {
    "url": "https://github.com/JoshuaAFerguson/apex/issues"
  },
  "homepage": "https://github.com/JoshuaAFerguson/apex#readme",
  "keywords": [
    "apex",
    "ai",
    "agents",
    "orchestration",
    "claude",
    "anthropic"
  ],
  "author": "Joshua A. Ferguson",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
