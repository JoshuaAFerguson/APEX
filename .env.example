ANTHROPIC_API_KEY=your_api_key_here

# Slack Socket Mode
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_DEFAULT_CHANNEL=#apex
SLACK_NOTIFICATION_CHANNELS=#apex
SLACK_THREAD_UPDATES=true
SLACK_USE_BLOCKS=true

# Discord Integration
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_APPLICATION_ID=your-discord-application-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_PUBLIC_KEY=your-discord-public-key
DISCORD_DEV_GUILD_ID=your-dev-server-id
DISCORD_DEFAULT_CHANNEL_ID=1234567890123456789
DISCORD_NOTIFICATION_CHANNELS=1234567890123456789,0987654321098765432
DISCORD_THREAD_UPDATES=true
DISCORD_USE_EMBEDS=true
DISCORD_INTERACTIONS_ENDPOINT=https://your-domain.com/discord/interactions
